# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock.bak

# Generated code — regenerated by build_runner, never committed
*.g.dart
*.freezed.dart
*.gr.dart
*.mocks.dart

# Android
android/.gradle/
android/local.properties
android/key.properties
android/app/*.jks
android/app/*.keystore
android/captures/
*.apk
*.aab
*.keystore
*.jks

# iOS (post-v1, but ignore now so it never lands accidentally)
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/flutter_export_environment.sh
ios/Flutter/Generated.xcconfig

# IDE
.idea/
.vscode/
*.iml
*.iws

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test output
coverage/
test/**/failures/

# Large downloaded assets — bundled sets are committed, downloadable ones are not
assets/images/1260/
assets/images/1920/
assets/audio/

# Local scratch
scratch/
*.local
